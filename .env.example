# ── Backend environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Required: Groq API key for LLM inference (llama-3.3-70b-versatile)
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required: Gemini API key (fallback when Groq hits rate limits)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: NASA FIRMS MAP key for active fire / wildfire detection data
# Get yours (free) at https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Required in production: comma-separated list of allowed CORS origins
# Local dev defaults to localhost:3000 if this is unset.
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://natural-disaster.io
CORS_ORIGINS=http://localhost:3000

# Optional: override log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── Frontend environment variables (.env.local in frontend/) ─────────────────

# Required in production: full URL to the backend /chat endpoint
# Example: NEXT_PUBLIC_BACKEND_CHAT_URL=https://your-hf-space.hf.space/chat
NEXT_PUBLIC_BACKEND_CHAT_URL=http://localhost:8000/chat
